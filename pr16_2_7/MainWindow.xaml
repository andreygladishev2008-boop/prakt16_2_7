<Window x:Class="pr16_2_7.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Система учета успеваемости студентов" 
        Height="600" Width="750"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Учет успеваемости студентов" 
                   FontSize="18" FontWeight="Bold" 
                   HorizontalAlignment="Center" Margin="0,0,0,10"/>

        <Border Grid.Row="1" BorderBrush="Gray" BorderThickness="1" 
                CornerRadius="5" Padding="8" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="Студент:" VerticalAlignment="Center" Margin="5"/>
                <TextBox x:Name="txtName" Width="100" Margin="5"/>

                <TextBlock Text="Предмет:" VerticalAlignment="Center" Margin="5"/>
                <TextBox x:Name="txtSubject" Width="100" Margin="5"/>

                <TextBlock Text="Оценка:" VerticalAlignment="Center" Margin="5"/>
                <TextBox x:Name="txtGrade" Width="50" Margin="5"/>
            </StackPanel>
        </Border>

        <WrapPanel Grid.Row="2" Margin="0,0,0,10" HorizontalAlignment="Center">
            <Button x:Name="btnAdd" Content="Добавить оценку" 
                    Click="BtnAdd_Click" Width="120" Margin="5" Padding="5"/>
            <Button x:Name="btnSave" Content="Сохранить" 
                    Click="BtnSave_Click" Width="100" Margin="5" Padding="5"/>
            <Button x:Name="btnLoad" Content="Загрузить" 
                    Click="BtnLoad_Click" Width="100" Margin="5" Padding="5"/>
            <Button x:Name="btnClear" Content="Очистить" 
                    Click="BtnClear_Click" Width="100" Margin="5" Padding="5"/>
        </WrapPanel>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" BorderBrush="Gray" BorderThickness="1" CornerRadius="5" Margin="0,0,5,0">
                <StackPanel>
                    <TextBlock Text="Список студентов" FontWeight="Bold" Margin="5" Background="LightGray" Padding="5"/>
                    <ComboBox x:Name="cmbStudents" Margin="5" SelectionChanged="CmbStudents_SelectionChanged"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" BorderBrush="Gray" BorderThickness="1" CornerRadius="5" Margin="5,0,0,0">
                <StackPanel Margin="8">
                    <TextBlock Text="Информация о студенте" FontWeight="Bold" Margin="0,0,0,10"/>

                    <StackPanel Orientation="Horizontal" Margin="0,3">
                        <TextBlock Text="Средняя оценка:" Width="110"/>
                        <TextBlock x:Name="tbAverage" Text="0"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,3">
                        <TextBlock Text="Успеваемость:" Width="110"/>
                        <Border x:Name="borderAverage" Width="80" Height="18" CornerRadius="2" BorderBrush="Black" BorderThickness="1"/>
                    </StackPanel>

                    <StackPanel Margin="0,10">
                        <TextBlock Text="Положительных оценок:"/>
                        <ProgressBar x:Name="progressBar" Height="20" Minimum="0" Maximum="100" Margin="0,5"/>
                        <TextBlock x:Name="tbPercent" Text="0%" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <Border x:Name="statusBorder" CornerRadius="5" Padding="8" Margin="0,10" Background="LightGray">
                        <TextBlock x:Name="tbStatus" Text="НЕТ СТУДЕНТОВ" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>