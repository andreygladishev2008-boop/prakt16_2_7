<Window x:Class="pr16_2_7.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:pr16_2_7"
        mc:Ignorable="d"
        Title="Успеваемость студентов" Height="500" Width="550">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Добавление оценок -->
        <GroupBox Header="Добавить оценку" Margin="5">
            <StackPanel Orientation="Horizontal" Margin="5">
                <TextBox x:Name="txtName" Width="100" Margin="2" ToolTip="Имя студента"/>
                <TextBox x:Name="txtSubject" Width="100" Margin="2" ToolTip="Предмет"/>
                <TextBox x:Name="txtGrade" Width="50" Margin="2" ToolTip="Оценка 1-5"/>
                <Button x:Name="btnAdd" Content="Добавить" Click="BtnAdd_Click" Margin="2" Padding="10,5"/>
                <Button x:Name="btnClear" Content="Очистить" Click="BtnClear_Click" Margin="2" Padding="10,5"/>
            </StackPanel>
        </GroupBox>

        <!-- Список студентов (простой) -->
        <GroupBox Header="Студенты" Grid.Row="1" Margin="5">
            <ComboBox x:Name="cmbStudents" DisplayMemberPath="Key" 
                      SelectionChanged="CmbStudents_SelectionChanged"/>
        </GroupBox>

        <!-- ИНДИКАТОР СРЕДНЕЙ ОЦЕНКИ (цветной) -->
        <Border x:Name="borderAverage" Grid.Row="2" CornerRadius="10" Padding="10" Margin="5">
            <StackPanel>
                <TextBlock Text="СРЕДНЯЯ ОЦЕНКА" FontWeight="Bold" HorizontalAlignment="Center" FontSize="14"/>
                <TextBlock x:Name="tbAverage" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- ПРОГРЕСС-БАР успеваемости -->
        <StackPanel Grid.Row="3" Margin="5">
            <TextBlock Text="Процент хороших оценок (4 и 5)" FontWeight="Bold"/>
            <ProgressBar x:Name="progressBar" Height="30" Minimum="0" Maximum="100"/>
            <TextBlock x:Name="tbPercent" HorizontalAlignment="Center" FontSize="14" FontWeight="Bold" Margin="5"/>

            <!-- Статус допуска -->
            <TextBlock x:Name="tbStatus" TextAlignment="Center" FontSize="16" FontWeight="Bold" Margin="5"/>
        </StackPanel>

        <!-- Кнопки CSV -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
            <Button x:Name="btnSave" Content="💾 Сохранить" Click="BtnSave_Click" Width="100" Margin="5"/>
            <Button x:Name="btnLoad" Content="📂 Загрузить" Click="BtnLoad_Click" Width="100" Margin="5"/>
        </StackPanel>
    </Grid>
</Window>
